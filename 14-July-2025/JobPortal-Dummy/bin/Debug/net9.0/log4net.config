<?xml version="1.0" encoding="utf-8" ?>
<log4net>

  <!-- Azure Blob Appender for error logs -->
  <appender name="ErrorFileAppender" type="JobPortal.Services.AzureBlobLogAppender, JobPortal">
  
    <SasUrl value="https://muthustorage.blob.core.windows.net/jobportal?sp=racwdli&st=2025-07-14T06:39:46Z&se=2025-07-14T14:39:46Z&sv=2024-11-04&sr=c&sig=JxukN%2BwN7UaFvOS6l2RAX5nVKCHvFY1hGwBdXpZxRJE%3D" />
    <BlobName value="logs/error-log.txt" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level - %message%newline" />
    </layout>
  </appender>

  <!-- Azure Blob Appender for data logs -->
  <appender name="DataChangeFileAppender" type="JobPortal.Services.AzureBlobLogAppender, JobPortal">
    <SasUrl value="https://muthustorage.blob.core.windows.net/jobportal?sp=racwdli&st=2025-07-14T06:39:46Z&se=2025-07-14T14:39:46Z&sv=2024-11-04&sr=c&sig=JxukN%2BwN7UaFvOS6l2RAX5nVKCHvFY1hGwBdXpZxRJE%3D" />
    <BlobName value="logs/datachange-log.txt" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level - %message%newline" />
    </layout>
  </appender>

  <!-- Logger for errors -->
  <logger name="ErrorFileAppender" additivity="false">
    <level value="ERROR" />
    <appender-ref ref="ErrorFileAppender" />
  </logger>

  <!-- Logger for data logs -->
  <logger name="DataChangeFileAppender" additivity="false">
    <level value="INFO" />
    <appender-ref ref="DataChangeFileAppender" />
  </logger>

  <!-- Root logger -->
  <root>
    <level value="OFF" />
  </root>

</log4net>
